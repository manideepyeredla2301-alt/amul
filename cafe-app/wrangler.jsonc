{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "frostflow-cafe",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-22",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "frostflow-online",
      "database_id": "64460bde-1a74-4ede-9c7f-88ecbc2a3ace",
      "migrations_dir": "migrations",
      "migrations_table": "cafe_migrations"
    }
  ],
  "vars": {
    "CAFE_ADMIN_USER": "rachana"
  }
}
